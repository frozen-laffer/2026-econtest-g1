#include "ILI9488.h"
#include "debug_print.h"
#include <string.h>
#include <stdio.h>

static ILI9488_DMA_State dma_state = ILI9488_DMA_IDLE;
static ILI9488_DMATxCpltCallback dma_callback = NULL;
static volatile uint8_t dma_complete_flag = 0;
static ILI9488_Rotation lcd_rotation = ILI9488_ROTATION_0;

static void LCD_Color565To666(uint16_t color, uint8_t *rgb){
	rgb[0] = ((color >> 11) & 0x1F) << 3;
	rgb[1] = ((color >> 5) & 0x3F) << 2;
	rgb[2] = (color & 0x1F) << 3;
}

static uint16_t LCD_GetWidth(void){
    return (lcd_rotation == ILI9488_ROTATION_90 || lcd_rotation == ILI9488_ROTATION_270) ? LCD_HEIGHT : LCD_WIDTH;
}

static uint16_t LCD_GetHeight(void){
    return (lcd_rotation == ILI9488_ROTATION_90 || lcd_rotation == ILI9488_ROTATION_270) ? LCD_WIDTH : LCD_HEIGHT;
}

/* ──────────────────────────────────────────────────────────────
   ★★★ 高速 GPIO Bit-Bang SPI ★★★
   ────────────────────────────────────────────────────────────── */

static inline void BB_WriteByte(uint8_t data)
{
    if (data & 0x80) { GPIOD->BSRR = (1UL << 7); } else { GPIOD->BSRR = (1UL << (7+16)); } __DSB(); GPIOB->BSRR = (1UL << 3); __DSB(); GPIOB->BSRR = (1UL << (3+16));
    if (data & 0x40) { GPIOD->BSRR = (1UL << 7); } else { GPIOD->BSRR = (1UL << (7+16)); } __DSB(); GPIOB->BSRR = (1UL << 3); __DSB(); GPIOB->BSRR = (1UL << (3+16));
    if (data & 0x20) { GPIOD->BSRR = (1UL << 7); } else { GPIOD->BSRR = (1UL << (7+16)); } __DSB(); GPIOB->BSRR = (1UL << 3); __DSB(); GPIOB->BSRR = (1UL << (3+16));
    if (data & 0x10) { GPIOD->BSRR = (1UL << 7); } else { GPIOD->BSRR = (1UL << (7+16)); } __DSB(); GPIOB->BSRR = (1UL << 3); __DSB(); GPIOB->BSRR = (1UL << (3+16));
    if (data & 0x08) { GPIOD->BSRR = (1UL << 7); } else { GPIOD->BSRR = (1UL << (7+16)); } __DSB(); GPIOB->BSRR = (1UL << 3); __DSB(); GPIOB->BSRR = (1UL << (3+16));
    if (data & 0x04) { GPIOD->BSRR = (1UL << 7); } else { GPIOD->BSRR = (1UL << (7+16)); } __DSB(); GPIOB->BSRR = (1UL << 3); __DSB(); GPIOB->BSRR = (1UL << (3+16));
    if (data & 0x02) { GPIOD->BSRR = (1UL << 7); } else { GPIOD->BSRR = (1UL << (7+16)); } __DSB(); GPIOB->BSRR = (1UL << 3); __DSB(); GPIOB->BSRR = (1UL << (3+16));
    if (data & 0x01) { GPIOD->BSRR = (1UL << 7); } else { GPIOD->BSRR = (1UL << (7+16)); } __DSB(); GPIOB->BSRR = (1UL << 3); __DSB(); GPIOB->BSRR = (1UL << (3+16));
}

/* BB_WriteBuf — 纯写数据，调用方负责 CS/DC 管理 */
static void BB_WriteBuf(const uint8_t *data, uint32_t len)
{
    for (uint32_t i = 0; i < len; i++)
        BB_WriteByte(data[i]);
}

static void SPI1_BitBang_Init(void)
{
    GPIOB->MODER = (GPIOB->MODER & ~0x000000C0UL) | 0x00000040UL;
    GPIOB->OTYPER &= ~(1UL << 3);
    GPIOB->OSPEEDR |= (3UL << 6);
    GPIOB->PUPDR &= ~(3UL << 6);

    GPIOD->MODER = (GPIOD->MODER & ~0x0000C000UL) | 0x00004000UL;
    GPIOD->OTYPER &= ~(1UL << 7);
    GPIOD->OSPEEDR |= (3UL << 14);
    GPIOD->PUPDR &= ~(3UL << 14);

    GPIOB->MODER = (GPIOB->MODER & ~0x00003000UL) | 0x00001000UL;
    GPIOB->OTYPER &= ~(1UL << 6);
    GPIOB->OSPEEDR |= (3UL << 12);
    GPIOB->PUPDR &= ~(3UL << 12);
    GPIOB->BSRR = (1UL << (6+16));

    GPIOB->MODER = (GPIOB->MODER & ~0x00000C00UL) | 0x00000400UL;
    GPIOB->OTYPER &= ~(1UL << 5);
    GPIOB->OSPEEDR |= (3UL << 10);
    GPIOB->PUPDR &= ~(3UL << 10);

    GPIOD->MODER = (GPIOD->MODER & ~0x00000300UL) | 0x00000100UL;
    GPIOD->OTYPER &= ~(1UL << 4);
    GPIOD->OSPEEDR |= (3UL << 8);
    GPIOD->PUPDR &= ~(3UL << 8);
    GPIOD->BSRR = (1UL << (4+16));

    __DSB();
    GPIOB->BSRR = (1UL << (3+16));
    GPIOD->BSRR = (1UL << (7+16));
    __DSB();
}

#define SPI1_Reg_Transmit(d)        BB_WriteByte((uint8_t)(d))
#define SPI1_Reg_Transmit_N(d, n)   BB_WriteBuf((const uint8_t *)(d), (uint32_t)(n))

void LCD_WriteCommand(uint8_t command){
    DC_LOW(); CS_LOW(); BB_WriteByte(command); CS_HIGH();
}

void LCD_WriteData(uint8_t data){
    DC_HIGH(); CS_LOW(); BB_WriteByte(data); CS_HIGH();
}

void LCD_WriteData16(uint16_t data){
    uint8_t rgb[3];
    LCD_Color565To666(data, rgb);
    DC_HIGH(); CS_LOW(); BB_WriteBuf(rgb, 3); CS_HIGH();
}

void LCD_WriteDataBuffer16(const uint16_t* buffer, uint32_t len){
    if (len == 0) return;
    DC_HIGH(); CS_LOW();
    for (uint32_t i = 0; i < len; i++) {
        uint8_t rgb[3]; LCD_Color565To666(buffer[i], rgb); BB_WriteBuf(rgb, 3);
    }
    CS_HIGH();
}

void HAL_SPI_TxCpltCallback(SPI_HandleTypeDef *hspi){
    if (hspi->Instance == SPI1) {
        dma_complete_flag = 1; dma_state = ILI9488_DMA_IDLE;
        if (dma_callback != NULL) dma_callback();
    }
}

void LCD_WaitDMAComplete(void){
    uint32_t start_time = HAL_GetTick();
    while(dma_complete_flag == 0){
        if(HAL_GetTick() - start_time > 2000){ dma_state = ILI9488_DMA_ERROR; break; }
    }
}
ILI9488_DMA_State ILI9488_GetDMAState(void) { return dma_state; }
void ILI9488_SetDMAState(ILI9488_DMA_State state) { dma_state = state; }
void ILI9488_SetDMACallback(ILI9488_DMATxCpltCallback callback) { dma_callback = callback; }

void LCD_SetRotation(ILI9488_Rotation rotation) {
    uint8_t madctl;
    switch (rotation) {
        case ILI9488_ROTATION_0:   madctl = 0x48; break;
        case ILI9488_ROTATION_90:  madctl = 0x28; break;
        case ILI9488_ROTATION_180: madctl = 0x88; break;
        case ILI9488_ROTATION_270: madctl = 0xE8; break;
        default:                   madctl = 0x48; rotation = ILI9488_ROTATION_0; break;
    }
    LCD_WriteCommand(0x36); LCD_WriteData(madctl);
    lcd_rotation = rotation;
}

void LCD_Reset(void) {
    RST_HIGH(); HAL_Delay(5);
    RST_LOW();  HAL_Delay(20);
    RST_HIGH(); HAL_Delay(20);
}

void LCD_Init(void){
    SPI1_BitBang_Init();
    LCD_Reset();
    LCD_WriteCommand(0x01); HAL_Delay(10);

    LCD_WriteCommand(0xE0);
    uint8_t gammaP[] = {0x00,0x03,0x09,0x08,0x16,0x0A,0x3F,0x78,0x4C,0x09,0x0A,0x08,0x16,0x1A,0x0F};
    for(uint8_t i=0;i<15;i++) LCD_WriteData(gammaP[i]);

    LCD_WriteCommand(0xE1);
    uint8_t gammaN[] = {0x00,0x16,0x19,0x03,0x0F,0x05,0x32,0x45,0x46,0x04,0x0E,0x0D,0x35,0x37,0x0F};
    for(uint8_t i=0;i<15;i++) LCD_WriteData(gammaN[i]);

    LCD_WriteCommand(0xC0); LCD_WriteData(0x17); LCD_WriteData(0x15);
    LCD_WriteCommand(0xC1); LCD_WriteData(0x41);
    LCD_WriteCommand(0xC5); LCD_WriteData(0x00); LCD_WriteData(0x12); LCD_WriteData(0x80);
    LCD_SetRotation(ILI9488_ROTATION_0);
    LCD_WriteCommand(0x3A); LCD_WriteData(0x66);
    LCD_WriteCommand(0xB0); LCD_WriteData(0x00);
    LCD_WriteCommand(0xB1); LCD_WriteData(0xA0);
    LCD_WriteCommand(0xB4); LCD_WriteData(0x02);
    LCD_WriteCommand(0xB6); LCD_WriteData(0x02); LCD_WriteData(0x02);
    LCD_WriteCommand(0xE9); LCD_WriteData(0x00);
    LCD_WriteCommand(0xF7); LCD_WriteData(0xA9); LCD_WriteData(0x51); LCD_WriteData(0x2C); LCD_WriteData(0x82);
    LCD_WriteCommand(0x11); HAL_Delay(120);
    LCD_WriteCommand(0x29); HAL_Delay(20);
    LCD_FillColor(LCD_BLACK);
}

void LCD_SPI_Init(void) { SPI1_BitBang_Init(); }
uint16_t LCD_ReadID(void) { return 0x9488; }
uint16_t LCD_ReadID_FullDuplex(void) { return 0x9488; }

void LCD_SetWindow(uint16_t x0, uint16_t y0, uint16_t x1, uint16_t y1) {
    LCD_WriteCommand(0x2A);
    LCD_WriteData(x0 >> 8); LCD_WriteData(x0 & 0xFF);
    LCD_WriteData(x1 >> 8); LCD_WriteData(x1 & 0xFF);
    LCD_WriteCommand(0x2B);
    LCD_WriteData(y0 >> 8); LCD_WriteData(y0 & 0xFF);
    LCD_WriteData(y1 >> 8); LCD_WriteData(y1 & 0xFF);
}

void LCD_DrawPixel(uint16_t x, uint16_t y, uint16_t color) {
    uint16_t w = LCD_GetWidth(), h = LCD_GetHeight();
    if (x >= w || y >= h) return;
    LCD_SetWindow(x, y, x, y);
    LCD_WriteCommand(0x2C);
    uint8_t rgb[3]; LCD_Color565To666(color, rgb);
    DC_HIGH(); CS_LOW(); BB_WriteBuf(rgb, 3); CS_HIGH();
}

/* ── 快速全屏填充 ── */
void LCD_FillColor(uint16_t color) {
    uint16_t w = LCD_GetWidth(), h = LCD_GetHeight();
    uint32_t total = (uint32_t)w * h;
    LCD_SetWindow(0, 0, w-1, h-1);
    LCD_WriteCommand(0x2C);
    uint8_t rgb[3]; LCD_Color565To666(color, rgb);
    DC_HIGH(); CS_LOW();

    #define FCHUNK 2048
    static uint8_t chunk[FCHUNK*3];
    for (uint32_t i=0; i<FCHUNK*3; i+=3) { chunk[i]=rgb[0]; chunk[i+1]=rgb[1]; chunk[i+2]=rgb[2]; }

    uint32_t remain = total;
    while (remain > 0) {
        uint32_t pix = (remain > FCHUNK) ? FCHUNK : remain;
        for (uint32_t i=0; i<pix*3; i++) BB_WriteByte(chunk[i]);
        remain -= pix;
    }
    CS_HIGH();
}

/* ── 区域填充 ── */
void LCD_FillRect(uint16_t x1, uint16_t y1, uint16_t x2, uint16_t y2, uint16_t color) {
    if (x1>x2){uint16_t t=x1;x1=x2;x2=t;} if (y1>y2){uint16_t t=y1;y1=y2;y2=t;}
    uint16_t w=LCD_GetWidth(),h=LCD_GetHeight();
    if (x1>=w||y1>=h) return; if (x2>=w) x2=w-1; if (y2>=h) y2=h-1;
    uint32_t total = (uint32_t)(x2-x1+1)*(uint32_t)(y2-y1+1);
    LCD_SetWindow(x1,y1,x2,y2); LCD_WriteCommand(0x2C);
    uint8_t rgb[3]; LCD_Color565To666(color, rgb);
    DC_HIGH(); CS_LOW();

    #define RCHUNK 2048
    static uint8_t rchunk[RCHUNK*3];
    for (uint32_t i=0;i<RCHUNK*3;i+=3){rchunk[i]=rgb[0];rchunk[i+1]=rgb[1];rchunk[i+2]=rgb[2];}
    uint32_t remain=total;
    while(remain>0){uint32_t pix=(remain>RCHUNK)?RCHUNK:remain; for(uint32_t i=0;i<pix*3;i++)BB_WriteByte(rchunk[i]); remain-=pix;}
    CS_HIGH();
}

void LCD_DrawImageRect(uint16_t x1, uint16_t y1, uint16_t x2, uint16_t y2, const uint16_t *colors) {
    if (!colors) return;
    if (x1>x2){uint16_t t=x1;x1=x2;x2=t;} if (y1>y2){uint16_t t=y1;y1=y2;y2=t;}
    uint16_t w=LCD_GetWidth(),h=LCD_GetHeight();
    if (x1>=w||y1>=h) return; if (x2>=w) x2=w-1; if (y2>=h) y2=h-1;
    LCD_SetWindow(x1,y1,x2,y2); LCD_WriteCommand(0x2C);
    uint32_t remain=(uint32_t)(x2-x1+1)*(uint32_t)(y2-y1+1), offset=0;
    #define ICHUNK 256
    static uint8_t ibuf[ICHUNK*3];
    DC_HIGH(); CS_LOW();
    while(remain>0){uint32_t pix=(remain>ICHUNK)?ICHUNK:remain; for(uint32_t i=0;i<pix;i++){uint8_t*rgb=&ibuf[i*3];LCD_Color565To666(colors[offset+i],rgb);} for(uint32_t i=0;i<pix*3;i++)BB_WriteByte(ibuf[i]); offset+=pix; remain-=pix;}
    CS_HIGH();
}

void LCD_InitDMA(void) { LCD_Init(); dma_state=ILI9488_DMA_IDLE; dma_callback=NULL; dma_complete_flag=0; LCD_FillColor(LCD_BLACK); }


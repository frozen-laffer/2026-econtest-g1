/* ── 6×8 字符绘制（使用 LCD_DrawPixel — 已可靠验证）── */
/* ── 6×8 optimized: single window batch output ── */
static void lcd_fill_rect_raw(uint16_t x1, uint16_t y1, uint16_t x2, uint16_t y2, uint16_t color);

void LCD_DrawChar(uint16_t x, uint16_t y, char c, uint16_t color, uint16_t bg)
{
    if (c < 32 || c > 126) c = ' ';
    uint8_t idx = (uint8_t)(c - 32);
    const uint8_t *ch = font6x8[idx];
    for (uint8_t row = 0; row < 8; row++) {
        for (uint8_t col = 0; col < 6; col++) {
            uint8_t bit = (ch[col] >> (7 - row)) & 1;
            LCD_DrawPixel(x + col, y + row, bit ? color : bg);
        }
    }
}

void LCD_DrawString(uint16_t x, uint16_t y, const char *str, uint16_t color, uint16_t bg)
{
    while (str && *str) {
        LCD_DrawChar(x, y, *str, color, bg);
        x += 7;
        str++;
    }
}
